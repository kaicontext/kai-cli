+package acme.perm;
+
+public class ProjectPermissions {
+    public Set<String> projectsWithAccess(Store store, Org org) {
+        Set<String> granted = new HashSet<>();
+        for (Entry entry : store.findByOwner(org, org.getId())) {
+            granted.add(entry.getName());
+        }
+        return granted;
+    }
+}
