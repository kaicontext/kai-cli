diff --git a/src/jobs/worker.ts b/src/jobs/worker.ts
new file mode 100644
--- /dev/null
+++ b/src/jobs/worker.ts
@@ -0,0 +1,10 @@
+import { db } from '../db';
+
+export async function recordFailure(jobId: string) {
+  const job = await db.job.findUnique({ where: { id: jobId } });
+  if (!job) return;
+  await db.job.update({
+    where: { id: jobId },
+    data: { attempts: job.attempts + 1 },
+  });
+}
